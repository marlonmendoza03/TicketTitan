# ============================================================================
# END-TO-END TEST CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in your values
# ============================================================================

# Application URLs
E2E_BASE_URL=http://localhost:5173
E2E_API_URL=http://localhost:5255

# ============================================================================
# AUTHENTICATION (Choose ONE method)
# ============================================================================

# Method 1: Google OAuth credentials (for full login flow)
# Get from Google Cloud Console
E2E_GOOGLE_EMAIL=your-test-account@gmail.com
E2E_GOOGLE_PASSWORD=your-test-password

# Method 2: Pre-authenticated cookies (faster, no Google OAuth)
# 1. Manually log in to the app
# 2. Open DevTools → Application → Cookies
# 3. Copy TicketTitan.Auth cookie value
# 4. Copy TicketTitan.AntiForgery cookie value
# E2E_AUTH_COOKIE=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# E2E_CSRF_COOKIE=CfDJ8...

# ============================================================================
# OPTIONAL SETTINGS
# ============================================================================

# Test timeout multiplier (for slow CI environments)
# E2E_TIMEOUT_MULTIPLIER=2

# Run in headed mode (see browser)
# E2E_HEADED=true

# ============================================================================
# NOTES
# ============================================================================
# - For Google OAuth: Use a dedicated test account (not production)
# - For cookie auth: Cookies expire, so refresh periodically
# - Both API and UI servers must be running before tests
# - Test assets are auto-generated in e2e/test-assets/